{
  "description": "Codex adapter for existing .claude/settings.json rules. Review and trust in Codex before relying on execution. Shared bridge normalizes apply_patch file paths.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|apply_patch|Write|Edit|Read",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 /Users/parkerarob/Documents/GitHub/workshop/.agents/hooks/codex_area_adapter.py --root \"$(git rev-parse --show-toplevel)\" --event PreToolUse",
            "timeout": 20,
            "statusMessage": "Checking repository-owned Area rules"
          }
        ]
      }
    ]
  }
}
